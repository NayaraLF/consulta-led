{
  "outputDirectory": "public",
  "public": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/data/(.*)",
      "destination": "/data/$1",
      "permanent": true
    }
  ]
}
